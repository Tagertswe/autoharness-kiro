# Local, site-specific settings for the Kiro port. Copy to .env and fill in.
# .env is ignored by git: repository names and paths from a work environment must never be committed.
# Read by the installer, kiro/install.py (docs/kiro.md). Re-run it after changing a value.

# A clone of the shared skills repository. The only line that names it.
AUTOHARNESS_SHARED_SKILLS_REPO=/path/to/shared-skills-repo

# Folder for self-learned skills inside that clone.
AUTOHARNESS_GLOBAL_SKILLS_DIR=${AUTOHARNESS_SHARED_SKILLS_REPO}/self-learning-skills

# Send every learned skill to the folder above; write nothing into the repositories you work in.
AUTOHARNESS_DISABLE_PROJECT=1

# The repository's existing skills (conventions, merge-request creation), followed when publishing.
# Either a folder holding one directory per skill, or the path of a single SKILL.md.
AUTOHARNESS_PUBLISH_SKILL=${AUTOHARNESS_SHARED_SKILLS_REPO}/path/to/skills

# Open the merge request automatically when a turn ends with unpublished skill changes.
# The session that opens it shows a note with the full link; other sessions are told once.
AUTOHARNESS_AUTO_PUBLISH=1
